{
  "name": "Simkl TV — What's next?",
  "short_name": "Simkl TV",
  "description": "Your Simkl TV library, upcoming episodes, and watch progress in a focused installable app.",
  "id": "/simkltv/",
  "start_url": "/simkltv/",
  "scope": "/simkltv/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#f4f5f8",
  "theme_color": "#6255e7",
  "categories": ["entertainment", "lifestyle"],
  "icons": [
    {
      "src": "/simkltv/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/simkltv/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Aired episodes",
      "short_name": "Aired",
      "url": "/simkltv/?section=aired",
      "icons": [{ "src": "/simkltv/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Upcoming episodes",
      "short_name": "Next",
      "url": "/simkltv/?section=next",
      "icons": [{ "src": "/simkltv/icon-192.png", "sizes": "192x192" }]
    }
  ]
}
